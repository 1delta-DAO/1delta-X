# Production build config for the Rootstock pre-audit beta (core deployed 2026-10-09 from
# b23ec90; solver v3 + NativeBalance 2026-10-15; record: docs/deployment-rootstock-beta.md).
# `solver` = AggregatorFillSolver v3 (new orders name it); `nativeBalance` turns on the RBTC
# receive option on DIRECT markets (task 30). The filler still serves orders signed for v2
# (AGGREGATOR_SOLVER_LEGACY in packages/filler-worker/wrangler.toml). Everything here is PUBLIC —
# Vite inlines VITE_* into the bundle. A Pages build env var of the same name wins.
# Secrets (VITE_GRAPH_KEY is domain-restricted, not secret) stay in the Pages env.
VITE_DEPLOYMENTS={"30":{"settlement":"0xe6EDbb5c49Fb4CFb313476e3B78E274D3584ddf5","permit3":"0xabaefb5ae495Dcbce40d1e057346f31A500668a8","lens":"0xF9e905EdCC376FDaBF62Ca0966624611721C5206","solver":"0x5987A4AFE1b680DAC657506B69C56b06FFe86cD1","nativeBalance":"0xA45ec37619C9F9B2f9d54692d578D1b1246c854c","marketSolvers":{"rsk-30-usdrif-usd0":"pull"}}}
VITE_ORDERBOOK_URL=/api/book
# VITE_QUOTE_URL defaults to /api/quote when VITE_ORDERBOOK_URL is set.
