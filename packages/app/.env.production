# Production build config for the Rootstock pre-audit beta (deployed 2026-10-09 from
# b23ec90; record: docs/deployment-rootstock-beta.md). Everything here is PUBLIC —
# Vite inlines VITE_* into the bundle. A Pages build env var of the same name wins.
# Secrets (VITE_GRAPH_KEY is domain-restricted, not secret) stay in the Pages env.
VITE_DEPLOYMENTS={"30":{"settlement":"0xe6EDbb5c49Fb4CFb313476e3B78E274D3584ddf5","permit3":"0xabaefb5ae495Dcbce40d1e057346f31A500668a8","lens":"0xF9e905EdCC376FDaBF62Ca0966624611721C5206","solver":"0x33ccAcb24DA5c7f335819Da877FC03E4bf62E287","marketSolvers":{"rsk-30-usdrif-usd0":"pull"}}}
VITE_ORDERBOOK_URL=/api/book
# VITE_QUOTE_URL defaults to /api/quote when VITE_ORDERBOOK_URL is set.
