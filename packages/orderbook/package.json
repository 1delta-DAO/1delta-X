{
  "name": "@1delta-x/orderbook",
  "license": "MIT",
  "version": "0.0.1",
  "description": "Transport-agnostic order distribution for UniversalSettlement — protobuf message types, a self-authenticating verification pipeline, and an in-memory order Book. One Transport seam swaps a centralized backend for Waku P2P.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "pnpm --filter @1delta-x/sdk build && tsc -p tsconfig.json",
    "typecheck": "pnpm --filter @1delta-x/sdk build && tsc --noEmit -p tsconfig.json",
    "test": "pnpm --filter @1delta-x/sdk build && vitest run"
  },
  "dependencies": {
    "@1delta-x/sdk": "workspace:*",
    "protobufjs": "^7.4.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
