{
  "name": "@1delta-x/orderbook-worker",
  "license": "MIT",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Cloudflare Worker + SQLite Durable Object orderbook for the Rootstock beta: JSON-only, protobuf-free, alarm-driven chain maintenance and fill indexing.",
  "scripts": {
    "build-libs": "pnpm --filter @1delta-x/sdk build && pnpm --filter @1delta-x/orderbook build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "bundle-check": "node scripts/bundle-check.mjs"
  },
  "dependencies": {
    "@1delta-x/orderbook": "workspace:*",
    "@1delta-x/sdk": "workspace:*",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@1delta-x/orderbook-server": "workspace:*",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20261004.1",
    "typescript": "^5.6.3",
    "vitest": "^4.1.0",
    "wrangler": "^4.40.0"
  }
}
