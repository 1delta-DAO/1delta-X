{
  "name": "@1delta-x/rif-filler",
  "license": "MIT",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Minimal beta filler for the Rootstock USDRIF/USDT0 market run from an EOA: fills orders from the orderbook out of hot-wallet inventory, then rebalances through MoC redemption and the Uniswap v3 RIF pool.",
  "scripts": {
    "build": "pnpm --filter @1delta-x/sdk build && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "start": "tsx src/bin.ts",
    "status": "tsx src/bin.ts status",
    "mint": "tsx src/bin.ts mint"
  },
  "dependencies": {
    "@1delta-x/sdk": "workspace:*",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
